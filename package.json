{
  "name": "movievault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@cf-wasm/og": "0.5.0",
    "@tabler/icons-react": "^3.51.0",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "simple-git-hooks": "^2.14.0",
    "vite": "^8.3.7",
    "wrangler": "4.160.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no -- biome check --staged --no-errors-on-unmatched || { echo 'Biome found issues in staged files. Run: npm run check:fix, then git add and commit again.'; exit 1; }"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "satori": "0.33.5",
    "fflate": "0.7.5"
  }
}
