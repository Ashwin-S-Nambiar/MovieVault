{
  "name": "movievault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "simple-git-hooks": "^2.14.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no -- biome check --staged --no-errors-on-unmatched || { echo 'Biome found issues in staged files. Run: npm run check:fix, then git add and commit again.'; exit 1; }"
  }
}
