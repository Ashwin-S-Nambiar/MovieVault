{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/tmdb/:path*",
      "destination": "/api/tmdb?path=:path*"
    },
    {
      "source": "/tmdb-img/:path*",
      "destination": "https://image.tmdb.org/t/p/:path*"
    },
    {
      "source": "/:page(search|vault|universes)",
      "destination": "/share/:page.html"
    },
    {
      "source": "/watchlist",
      "destination": "/share/vault.html"
    },
    {
      "source": "/:kind(movie|tv)/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*([Bb]ot|[Cc]rawler|facebookexternalhit|WhatsApp|[Pp]review|[Ee]mbedly|[Ii]framely).*)"
        }
      ],
      "destination": "/api/page?route=/:kind/:id"
    },
    {
      "source": "/universe/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*([Bb]ot|[Cc]rawler|facebookexternalhit|WhatsApp|[Pp]review|[Ee]mbedly|[Ii]framely).*)"
        }
      ],
      "destination": "/api/page?route=/universe/:slug"
    },
    {
      "source": "/(movie|tv|person|company|network|keyword)/:id",
      "destination": "/index.html"
    },
    {
      "source": "/universe/:slug",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "movievault\\.ashwin\\.co\\.in"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(search|vault|watchlist)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(company|network|keyword)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/tmdb-img/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=31536000, immutable"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/og.js": {
      "includeFiles": "{server/fonts/*.{ttf,txt},public/film.svg,node_modules/@vercel/og/dist/*.{wasm,ttf}}"
    }
  }
}
